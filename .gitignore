# Everything derived from Ashby lives here: candidate CSVs, resume audits,
# the current-employee roster, and the generated directory page. All of it is
# PII. The whole directory is ignored so a new output file can never be
# committed by accident.
private/
!private/.gitkeep

# Local virtualenv
.venv/
venv/

# Python
__pycache__/
*.pyc

# Legacy locations — kept so an older checkout can't re-commit real data.
ashby_*.csv
campus-recruiting-directory.html
current_employees.json
